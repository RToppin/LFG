generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Platform {
  PC
  XBOX
  PLAYSTATION
  NINTENDO_SWITCH
  CROSS_PLATFORM
  OTHER
}

enum PostStatus {
  DRAFT
  ACTIVE
  FULL
  PAUSED
  CLOSED
  EXPIRED
  REMOVED_BY_MODERATION
}

enum HostingStatus {
  OWNER_HOSTING
  MEMBER_HOSTING
  NEED_HOST
  DEDICATED_SERVER
  UNDECIDED
}

enum JoinMode {
  OPEN
  APPROVAL_REQUIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum GroupMemberRole {
  OWNER
  CO_ORGANIZER
  MEMBER
}

enum CampaignDurationType {
  ONE_SESSION
  SEVERAL_SESSIONS
  WEEKEND
  ONE_WEEK
  TWO_WEEKS
  CUSTOM_RANGE
  ONGOING
}

enum ExperienceLevel {
  BEGINNER
  CASUAL
  EXPERIENCED
  EXPERT
  ANY
}

enum NotificationType {
  RECOMMENDED_POST
  NEW_JOIN_REQUEST
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  USER_JOINED_GROUP
  USER_LEFT_GROUP
  USER_REMOVED_FROM_GROUP
  GROUP_FULL
  GROUP_REOPENED
  GROUP_DETAILS_CHANGED
  DISCORD_INVITATION_UPDATED
  POST_EXPIRING_SOON
  POST_EXPIRED
  POST_REMOVED_BY_MODERATION
  GROUP_OWNERSHIP_TRANSFERRED
}

enum ReportType {
  SPAM
  HARASSMENT
  HATE_OR_ABUSIVE_CONTENT
  UNSAFE_DISCORD_INVITATION
  MISLEADING_POST
  INAPPROPRIATE_CONTENT
  SCAM
  OTHER
}

enum ModerationActionType {
  DISMISS_REPORT
  REMOVE_POST
  RESTORE_POST
  SUSPEND_USER
  RESTORE_USER
  ADD_GAME
  EDIT_GAME
  DISABLE_GAME
  MERGE_GAME
  INTERNAL_NOTE
}

enum ProfileVisibility {
  PUBLIC
  SIGNED_IN
  GROUP_MEMBERS
}

enum DiscordInvitationVisibility {
  PUBLIC
  APPROVED_MEMBERS
}

enum SocialLinkKind {
  WEBSITE
  TWITCH
  YOUTUBE
  STEAM
  X
  INSTAGRAM
  TIKTOK
  XBOX
  PLAYSTATION
  NINTENDO
  OTHER
}

enum GameApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum GameSource {
  CURATED
  STEAM
  USER_REQUEST
  ADMIN
}

enum GameRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  lfgPosts      LfgPost[]
  memberships   GroupMember[]
  joinRequests  JoinRequest[]
  savedPosts    SavedPost[]
  dismissals    DismissedRecommendation[]
  notifications Notification[]
  preferences   NotificationPreference?
  reportsMade   Report[] @relation("ReportsMade")
  reportsAgainst Report[] @relation("ReportsAgainst")
  blocksMade    Block[] @relation("BlocksMade")
  blockedBy     Block[] @relation("BlockedBy")
  moderationActions ModerationAction[]
  auditLogs      AuditLog[]
  approvedGames  Game[] @relation("GameApprover")
  gameRequests   GameRequest[] @relation("GameRequestsMade")
  reviewedGameRequests GameRequest[] @relation("GameRequestsReviewed")
  socialLinks    SocialLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  oauth_token_secret String?
  oauth_token       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                String            @id @default(cuid())
  userId            String            @unique
  username          String            @unique
  displayName       String
  bio               String?
  avatarUrl         String?
  timeZone          String
  region            String
  languages         String[]
  platforms         Platform[]
  playStyles        String[]
  availability      String?
  visibility        ProfileVisibility @default(PUBLIC)
  showPastGroups    Boolean           @default(false)
  discordConnected  Boolean           @default(false)
  discordUserId     String?
  discordUsername   String?
  discordDisplayName String?
  discordAvatar     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  games         UserGame[]
  availabilitySlots UserAvailability[]
}

model Game {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  shortName       String?
  coverImage      String?
  coverImageUrl   String?
  fallbackGradient String
  description     String
  source          GameSource         @default(CURATED)
  sourceRank      Int?
  steamAppId      Int?               @unique
  approvalStatus  GameApprovalStatus @default(APPROVED)
  active          Boolean            @default(true)
  isActive        Boolean            @default(true)
  listingEnabled  Boolean            @default(true)
  crossPlatform   Boolean            @default(false)
  modSupport      Boolean            @default(false)
  supportsOnlineCoop Boolean         @default(true)
  supportsLocalCoop Boolean          @default(false)
  supportsDedicatedServers Boolean   @default(false)
  supportsCrossplay Boolean          @default(false)
  minimumPlayers  Int?
  maximumPlayers  Int?
  aliases         String[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  approvedAt      DateTime?
  approvedById    String?
  deletedAt       DateTime?

  editions GameEdition[]
  platforms GamePlatform[]
  categories GameCategoryOnGame[]
  userGames UserGame[]
  posts     LfgPost[]
  requests  GameRequest[]
  approvedBy User? @relation("GameApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([approvalStatus])
  @@index([isActive])
  @@index([listingEnabled])
  @@index([sourceRank])
  @@index([steamAppId])
}

model GameCategory {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games GameCategoryOnGame[]
}

model GameCategoryOnGame {
  gameId     String
  categoryId String

  game     Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category GameCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([gameId, categoryId])
  @@index([categoryId])
}

model GameRequest {
  id            String            @id @default(cuid())
  requestedName String
  normalizedName String
  steamStoreUrl String?
  notes         String?
  status        GameRequestStatus @default(PENDING)
  probableGameId String?
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  probableGame Game? @relation(fields: [probableGameId], references: [id], onDelete: SetNull)
  requestedBy  User @relation("GameRequestsMade", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy   User? @relation("GameRequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([normalizedName])
  @@index([requestedById, status])
}

model GameEdition {
  id        String @id @default(cuid())
  gameId    String
  name      String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([gameId, name])
}

model GamePlatform {
  id       String   @id @default(cuid())
  gameId   String
  platform Platform

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([gameId, platform])
}

model UserGame {
  id             String          @id @default(cuid())
  userId         String
  profileId      String
  gameId         String
  platform       Platform
  experience     ExperienceLevel @default(ANY)
  playStyles     String[]
  canHost        Boolean         @default(false)
  usesMods       Boolean         @default(false)
  edition        String?
  notifications  Boolean         @default(true)
  favoriteOrder  Int             @default(0)
  recommendationsEnabled Boolean @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([profileId, gameId, platform])
  @@index([userId])
  @@index([gameId])
}

model UserAvailability {
  id        String @id @default(cuid())
  profileId String
  dayOfWeek Int
  startTime String
  endTime   String
  timeZone  String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, dayOfWeek])
}

model LfgPost {
  id                String               @id @default(cuid())
  ownerId           String
  gameId            String
  title             String
  description       String
  platform          Platform
  platforms         Platform[]           @default([])
  timeZone          String
  campaignStartsAt  DateTime
  campaignEndsAt    DateTime?
  flexibleTime      Boolean              @default(false)
  playersNeeded     Int
  currentGroupSize  Int                  @default(1)
  maxPlayers        Int
  playStyles        String[]
  hostingStatus     HostingStatus
  durationType      CampaignDurationType
  joinMode          JoinMode             @default(OPEN)
  status            PostStatus           @default(DRAFT)
  edition           String?
  serverRegion      String?
  recurringSchedule String?
  daysOfWeek        Int[]
  sessionLength     String?
  modded            Boolean              @default(false)
  modpackName       String?
  difficulty        String?
  progressionStage  String?
  requestedExperience ExperienceLevel     @default(ANY)
  microphoneRequired Boolean             @default(false)
  preferredLanguage String?
  minimumAge        Int?
  serverRules       String?
  existingWorld     Boolean              @default(false)
  waitlistEnabled   Boolean              @default(false)
  autoCloseWhenFull Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  publishedAt       DateTime?
  refreshedAt       DateTime?
  expiresAt         DateTime?
  closedAt          DateTime?
  deletedAt         DateTime?

  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  game        Game @relation(fields: [gameId], references: [id])
  playStyleRows LfgPostPlayStyle[]
  members     GroupMember[]
  joinRequests JoinRequest[]
  savedBy      SavedPost[]
  dismissals   DismissedRecommendation[]
  notifications Notification[]
  invitation   DiscordInvitation?
  reports      Report[]

  @@index([gameId, status, expiresAt])
  @@index([platform, status])
  @@index([platforms], type: Gin)
  @@index([campaignStartsAt])
  @@index([refreshedAt])
  @@index([timeZone])
  @@index([ownerId, status])
}

model LfgPostPlayStyle {
  id     String @id @default(cuid())
  postId String
  tag    String

  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([postId, tag])
}

model GroupMember {
  id        String          @id @default(cuid())
  postId    String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())
  removedAt DateTime?

  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@index([userId, removedAt])
}

model JoinRequest {
  id        String            @id @default(cuid())
  postId    String
  requesterId String
  message   String?
  status    JoinRequestStatus @default(PENDING)
  decidedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  post      LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  requester User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  @@index([postId, status])
  @@index([requesterId, status])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model DismissedRecommendation {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  undoneAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  postId    String?
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  archivedAt DateTime?
  dedupeKey String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post LfgPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  @@unique([userId, dedupeKey])
  @@index([userId, readAt, archivedAt])
}

model NotificationPreference {
  id                       String @id @default(cuid())
  userId                   String @unique
  inApp                    Boolean @default(true)
  email                    Boolean @default(false)
  recommendations          Boolean @default(true)
  joinRequests             Boolean @default(true)
  groupUpdates             Boolean @default(true)
  expirationReminders      Boolean @default(true)
  productAnnouncements     Boolean @default(false)
  disabledGameIds          String[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscordInvitation {
  id          String @id @default(cuid())
  postId      String @unique
  url         String
  code        String
  visibility  DiscordInvitationVisibility @default(APPROVED_MEMBERS)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revokedAt   DateTime?

  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id        String         @id @default(cuid())
  userId    String
  kind      SocialLinkKind
  url       String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, sortOrder])
}

model Block {
  id        String @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id            String     @id @default(cuid())
  reporterId    String
  reportedUserId String?
  postId        String?
  type          ReportType
  details       String?
  status        String     @default("OPEN")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  resolvedAt    DateTime?

  reporter     User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: SetNull)
  post         LfgPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  actions      ModerationAction[]
  @@index([status, createdAt])
}

model ModerationAction {
  id        String @id @default(cuid())
  actorId   String
  reportId  String?
  type      ModerationActionType
  note      String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor  User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  @@index([actorId, type])
}

model AuditLog {
  id        String @id @default(cuid())
  actorId   String?
  action    String
  targetType String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([targetType, targetId])
}
